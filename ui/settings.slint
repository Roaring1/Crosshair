import { Button, CheckBox, ComboBox, LineEdit, Slider, SpinBox, Switch, ScrollView, Palette } from "std-widgets.slint";

component ColorField inherits HorizontalLayout {
    in-out property <string> value;
    in property <color> swatch-color: #a000ff;
    in property <bool> align-right: false;
    callback committed();

    spacing: 6px;
    height: 28px;

    color-palette := PopupWindow {
        x: root.align-right ? root.width - self.width : 0px;
        y: root.height;
        width: 224px;
        height: 190px;

        Rectangle {
            width: 100%;
            height: 100%;
            background: Palette.background;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 5px;

            VerticalLayout {
                padding: 9px;
                spacing: 7px;

                Text {
                    text: "Choose a color";
                    font-weight: 600;
                }

                GridLayout {
                    width: 100%;
                    spacing: 5px;
                Row {
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #ef4444;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#ef4444";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #f97316;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#f97316";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #f59e0b;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#f59e0b";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #eab308;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#eab308";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #84cc16;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#84cc16";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #22c55e;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#22c55e";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                }
                Row {
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #10b981;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#10b981";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #14b8a6;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#14b8a6";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #06b6d4;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#06b6d4";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #0ea5e9;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#0ea5e9";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #3b82f6;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#3b82f6";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #6366f1;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#6366f1";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                }
                Row {
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #8b5cf6;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#8b5cf6";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #a855f7;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#a855f7";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #d946ef;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#d946ef";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #ec4899;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#ec4899";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #f43f5e;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#f43f5e";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #ffffff;
                        border-color: Palette.border;
                        border-width: 1px;
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#ffffff";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                }
                Row {
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #000000;
                        border-color: Palette.border;
                        border-width: 1px;
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#000000";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #1e293b;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#1e293b";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #334155;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#334155";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #64748b;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#64748b";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #94a3b8;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#94a3b8";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                    Rectangle {
                        width: 23px;
                        height: 23px;
                        background: #cbd5e1;
                        
                        border-radius: 4px;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.value = "#cbd5e1";
                                root.committed();
                                color-palette.close();
                            }
                        }
                    }
                }
                }

                Text {
                    text: "Choose a swatch or enter a custom HEX value in the field.";
                    font-size: 11px;
                    color: Palette.foreground;
                    wrap: word-wrap;
                }
            }
        }
    }

    Rectangle {
        width: 28px;
        height: 26px;
        background: root.swatch-color;
        border-color: Palette.border;
        border-width: 1px;
        border-radius: 4px;
        TouchArea {
            mouse-cursor: pointer;
            clicked => { color-palette.show(); }
        }
    }

    LineEdit {
        text <=> root.value;
        placeholder-text: "#RRGGBB";
        horizontal-stretch: 1;
        accepted => { root.committed(); }
    }
}

export component SettingsWindow inherits Window {
    title: "Crosshair Settings";
    width: 640px;
    height: (root.active-tab == 0 && !root.shortcuts-expanded && !root.profile-panel-visible ? 280px : 520px)
        + (root.active-tab == 0 ? 68px : 0px)
        + (root.system-feedback != "" ? 44px : 0px);
    animate height {
        duration: 140ms;
        easing: ease-in-out;
    }
    background: Palette.background;

    in-out property <int> active-tab: 0;
    in-out property <bool> enabled: true;
    in-out property <bool> auto-save: true;
    in-out property <string> activity-selection: "App UI";
    in-out property <[string]> activity-options: ["App UI", "Command only"];
    in-out property <string> monitor-selection: "All monitors";
    in-out property <[string]> monitor-options: ["All monitors", "Primary monitor", "Cursor-active monitor"];
    in-out property <string> shape: "dot";
    in-out property <float> crosshair-opacity: 0.95;
    in-out property <int> size: 5;
    in-out property <int> thickness: 2;
    in-out property <int> gap: 3;
    in-out property <string> color-text: "#a000ff";
    in-out property <color> preview-background: #222222;
    in-out property <string> preview-background-text: "#222222";
    in-out property <color> main-swatch: #a000ff;
    in-out property <color> outline-swatch: #000000;
    in-out property <color> shadow-swatch: #000000;
    in-out property <color> reference-swatch: #a000ff;
    in-out property <image> preview-image;

    in-out property <bool> outline-enabled: true;
    in-out property <bool> outline-expanded: false;
    in-out property <string> outline-color-text: "#000000";
    in-out property <float> outline-opacity: 0.8;
    in-out property <int> outline-thickness: 1;

    in-out property <bool> shadow-enabled: false;
    in-out property <bool> shadow-expanded: false;
    in-out property <string> shadow-color-text: "#000000";
    in-out property <float> shadow-opacity: 0.35;
    in-out property <int> shadow-x: 1;
    in-out property <int> shadow-y: 1;

    in-out property <bool> reference-enabled: false;
    in-out property <bool> reference-expanded: false;
    in-out property <string> reference-color-text: "#a000ff";
    in-out property <float> reference-opacity: 0.95;
    in-out property <int> reference-size: 3;
    in-out property <int> reference-x: 0;
    in-out property <int> reference-y: 64;

    in-out property <int> offset-x: 0;
    in-out property <int> offset-y: 0;

    in-out property <bool> shortcuts-expanded: false;
    in-out property <bool> profile-panel-visible: false;
    in-out property <bool> profile-is-export: false;
    in-out property <string> profile-code: "";
    in-out property <string> profile-feedback: "";
    in-out property <string> system-feedback: "";

    callback settings_changed();
    callback save_requested();
    callback reset_requested();
    callback import_profile(string);
    callback export_profile();
    callback open_config_folder();
    callback reload_config();
    callback install_autostart();
    callback remove_autostart();
    callback refresh_monitors();
    callback uninstall_app();


    uninstall-confirm := PopupWindow {
        x: root.width / 2 - self.width / 2;
        y: root.height / 2 - self.height / 2;
        width: 304px;
        height: 126px;
        Rectangle {
            background: Palette.background;
            width: 100%;
            height: 100%;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: "Uninstall Crosshair?";
                    font-weight: 600;
                }
                Text {
                    text: "The app files and menu entry will be removed. Your settings will be kept.";
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    HorizontalLayout { }
                    Button { text: "Cancel"; clicked => { uninstall-confirm.close(); } }
                    Button {
                        text: "Uninstall";
                        primary: true;
                        clicked => { root.uninstall_app(); uninstall-confirm.close(); }
                    }
                }
            }
        }
    }

    system-menu := PopupWindow {
        x: root.width - self.width - 12px;
        y: 38px;
        width: 188px;
        height: 210px;
        Rectangle {
            background: Palette.background;
            width: 100%;
            height: 100%;
            VerticalLayout {
            padding: 7px;
            spacing: 3px;
            Button { text: "Import crosshair code"; clicked => {
                root.profile-code = "";
                root.profile-is-export = false;
                root.profile-feedback = "";
                root.profile-panel-visible = true;
                system-menu.close();
            } }
            Button { text: "Export crosshair code"; clicked => {
                root.profile-is-export = true;
                root.profile-feedback = "";
                root.export_profile();
                root.profile-panel-visible = true;
                system-menu.close();
            } }
            Rectangle { height: 1px; background: Palette.border; }
            Button { text: "Open config folder"; clicked => { root.open_config_folder(); system-menu.close(); } }
            Button { text: "Reload config"; clicked => { root.reload_config(); system-menu.close(); } }
            Button { text: "Refresh monitors"; clicked => { root.refresh_monitors(); system-menu.close(); } }
            Button { text: "Uninstall"; clicked => { uninstall-confirm.show(); system-menu.close(); } }
            }
        }
    }

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        HorizontalLayout {
            height: 34px;
            spacing: 4px;
            Button {
                text: "General";
                checkable: true;
                checked: root.active-tab == 0;
                clicked => { root.active-tab = 0; }
            }
            Button {
                text: "Appearance";
                checkable: true;
                checked: root.active-tab == 1;
                clicked => { root.active-tab = 1; }
            }
            HorizontalLayout { }
            Button {
                text: "System";
                clicked => { system-menu.show(); }
            }
        }

        Rectangle { height: 1px; background: Palette.border; }

        if root.profile-panel-visible: Rectangle {
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 4px;
            background: Palette.alternate-background;
            height: 106px;
            VerticalLayout {
                padding: 8px;
                spacing: 5px;
                HorizontalLayout {
                    Text {
                        text: root.profile-is-export ? "Crosshair code" : "Import crosshair code";
                        vertical-alignment: center;
                        font-weight: 600;
                    }
                    HorizontalLayout { }
                    Button { text: "Close"; clicked => { root.profile-panel-visible = false; } }
                }
                profile_code_field := LineEdit {
                    text <=> root.profile-code;
                    placeholder-text: "CH1- paste or copy the code";
                    width: 100%;
                    read-only: root.profile-is-export;
                    accepted => { root.import_profile(root.profile-code); }
                }
                HorizontalLayout {
                    Text {
                        text: root.profile-feedback;
                        color: Palette.foreground;
                        vertical-alignment: center;
                    }
                    HorizontalLayout { }
                    if root.profile-is-export: Button { text: "Copy code"; primary: true; clicked => { profile_code_field.select-all(); profile_code_field.copy(); root.profile-feedback = "Copied to clipboard"; } }
                    if !root.profile-is-export: Button {
                        text: "Apply code";
                        primary: true;
                        clicked => { root.import_profile(root.profile-code); }
                    }
                }
            }
        }

        if root.active-tab == 0: ScrollView {
            width: 100%;
            height: root.height - 71px - (root.profile-panel-visible ? 114px : 0px);
            VerticalLayout {
                spacing: 8px;
                padding: 8px;

                HorizontalLayout {
                    height: 30px;
                    Switch {
                        text: "Enabled";
                        checked <=> root.enabled;
                        toggled => { root.settings_changed(); }
                    }
                    HorizontalLayout { }
                    Switch {
                        text: "Auto-save";
                        checked <=> root.auto-save;
                        toggled => { root.settings_changed(); }
                    }
                }

                HorizontalLayout {
                    height: 32px;
                    Text { text: "App Activity"; vertical-alignment: center; width: 82px; }
                    ComboBox {
                        model: root.activity-options;
                        current-value <=> root.activity-selection;
                        selected(value) => { root.activity-selection = value; root.settings_changed(); }
                        horizontal-stretch: 1;
                        height: 28px;
                    }
                }

                Text {
                    text: "This controls a plain launch only. Settings and CLI commands remain available explicitly in every mode. The tray is supported on Windows.";
                    font-size: 10px;
                    color: Palette.foreground;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    height: 32px;
                    Text { text: "Monitor"; vertical-alignment: center; width: 82px; }
                    ComboBox {
                        model: root.monitor-options;
                        current-value <=> root.monitor-selection;
                        selected(value) => { root.monitor-selection = value; root.settings_changed(); }
                        horizontal-stretch: 1;
                        height: 28px;
                    }
                }

                HorizontalLayout {
                    height: 30px;
                    Button { text: "Reset"; width: 90px; height: 28px; clicked => { root.reset_requested(); } }
                    if !root.auto-save: Button { text: "Save"; width: 90px; height: 28px; primary: true; clicked => { root.save_requested(); } }
                }

                if root.system-feedback != "":
                    Text {
                        text: root.system-feedback;
                        color: Palette.foreground;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                Rectangle { height: 1px; background: Palette.border; }

                HorizontalLayout {
                    height: 28px;
                    Text { text: "Shortcuts and startup"; font-weight: 600; vertical-alignment: center; }
                    HorizontalLayout { }
                    Button {
                        text: root.shortcuts-expanded ? "Hide" : "Show";
                        width: 64px;
                        height: 26px;
                        clicked => { root.shortcuts-expanded = !root.shortcuts-expanded; }
                    }
                }

                if root.shortcuts-expanded: VerticalLayout {
                    spacing: 7px;
                    Text {
                        text: "Wayland does not allow ordinary apps to capture global hotkeys. Create a desktop shortcut that runs this command:";
                        wrap: word-wrap;
                    }
                    Rectangle {
                        background: Palette.alternate-background;
                        border-radius: 3px;
                        height: 34px;
                        HorizontalLayout {
                            padding: 7px;
                            toggle_command_field := LineEdit { text: "crosshair --toggle"; read-only: true; }
                            HorizontalLayout { }
                            Button { text: "Copy"; clicked => { toggle_command_field.select-all(); toggle_command_field.copy(); } }
                        }
                    }
                    Text { text: "Optional login startup"; font-weight: 600; }
                    HorizontalLayout {
                        Button { text: "Install autostart"; clicked => { root.install_autostart(); } }
                        Button { text: "Remove autostart"; clicked => { root.remove_autostart(); } }
                    }
                }
            }
        }

        if root.active-tab == 1: HorizontalLayout {
            spacing: 10px;
            height: root.height - 71px - (root.profile-panel-visible ? 114px : 0px);

            ScrollView {
                width: 420px;
                height: 100%;
                VerticalLayout {
                    width: 100%;
                    spacing: 8px;
                    padding: 8px;

                    HorizontalLayout {
                        Text { text: "Shape"; width: 82px; vertical-alignment: center; }
                        ComboBox {
                            model: ["dot", "cross", "x", "plus", "ring", "dot_ring", "cross_dot", "x_dot"];
                            current-value <=> root.shape;
                            selected(value) => { root.shape = value; root.settings_changed(); }
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalLayout {
                        Text { text: "Opacity"; width: 82px; vertical-alignment: center; }
                        Slider { minimum: 0.05; maximum: 1; step: 0.01; value <=> root.crosshair-opacity; changed(value) => { root.settings_changed(); } }
                    }
                    HorizontalLayout {
                        Text { text: "Size"; width: 82px; vertical-alignment: center; }
                        Slider { minimum: 1; maximum: 200; step: 1; value: root.size; changed(value) => { root.size = round(value); root.settings_changed(); } }
                        SpinBox { minimum: 1; maximum: 200; value <=> root.size; edited => { root.settings_changed(); } }
                    }
                    HorizontalLayout {
                        Text { text: "Thickness"; width: 82px; vertical-alignment: center; }
                        Slider { minimum: 1; maximum: 100; step: 1; value: root.thickness; changed(value) => { root.thickness = round(value); root.settings_changed(); } }
                        SpinBox { minimum: 1; maximum: 100; value <=> root.thickness; edited => { root.settings_changed(); } }
                    }
                    HorizontalLayout {
                        Text { text: "Gap"; width: 82px; vertical-alignment: center; }
                        Slider { minimum: 0; maximum: 200; step: 1; value: root.gap; changed(value) => { root.gap = round(value); root.settings_changed(); } }
                        SpinBox { minimum: 0; maximum: 200; value <=> root.gap; edited => { root.settings_changed(); } }
                    }

                    HorizontalLayout {
                        Text { text: "Color"; width: 82px; vertical-alignment: center; }
                        ColorField {
                            value <=> root.color-text;
                            swatch-color: root.main-swatch;
                            committed => { root.settings_changed(); }
                        }
                    }

                    Rectangle { height: 1px; background: Palette.border; }

                    Button {
                        text: root.outline-expanded ? "Outline" : "Outline";
                        checkable: true;
                        checked: root.outline-enabled;
                        clicked => { root.outline-enabled = self.checked; root.settings_changed(); root.outline-expanded = !root.outline-expanded; }
                    }
                    if root.outline-expanded: VerticalLayout {
                        spacing: 5px;
                        HorizontalLayout {
                            Text { text: "Color"; width: 82px; }
                            ColorField {
                                value <=> root.outline-color-text;
                                swatch-color: root.outline-swatch;
                                committed => { root.settings_changed(); }
                            }
                        }
                        HorizontalLayout {
                            Text { text: "Opacity"; width: 82px; }
                            Slider { minimum: 0; maximum: 1; step: 0.01; value <=> root.outline-opacity; changed(value) => { root.settings_changed(); } }
                        }
                        HorizontalLayout {
                            Text { text: "Thickness"; width: 82px; }
                            SpinBox { minimum: 0; maximum: 100; value <=> root.outline-thickness; edited => { root.settings_changed(); } }
                        }
                    }

                    Button {
                        text: "Shadow";
                        checkable: true;
                        checked: root.shadow-enabled;
                        clicked => { root.shadow-enabled = self.checked; root.settings_changed(); root.shadow-expanded = !root.shadow-expanded; }
                    }
                    if root.shadow-expanded: VerticalLayout {
                        spacing: 5px;
                        HorizontalLayout {
                            Text { text: "Color"; width: 82px; }
                            ColorField {
                                value <=> root.shadow-color-text;
                                swatch-color: root.shadow-swatch;
                                committed => { root.settings_changed(); }
                            }
                        }
                        HorizontalLayout {
                            Text { text: "Opacity"; width: 82px; }
                            Slider { minimum: 0; maximum: 1; step: 0.01; value <=> root.shadow-opacity; changed(value) => { root.settings_changed(); } }
                        }
                        HorizontalLayout {
                            Text { text: "Offset X"; width: 82px; }
                            SpinBox { minimum: -200; maximum: 200; value <=> root.shadow-x; edited => { root.settings_changed(); } }
                        }
                        HorizontalLayout {
                            Text { text: "Offset Y"; width: 82px; }
                            SpinBox { minimum: -200; maximum: 200; value <=> root.shadow-y; edited => { root.settings_changed(); } }
                        }
                    }

                    Button {
                        text: "Second dot";
                        checkable: true;
                        checked: root.reference-enabled;
                        clicked => { root.reference-enabled = self.checked; root.settings_changed(); root.reference-expanded = !root.reference-expanded; }
                    }
                    if root.reference-expanded: VerticalLayout {
                        spacing: 5px;
                        Text {
                            text: "A separate reference point, for recoil or off-center aiming practice.";
                            color: Palette.foreground;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            Text { text: "Color"; width: 82px; }
                            ColorField {
                                value <=> root.reference-color-text;
                                swatch-color: root.reference-swatch;
                                committed => { root.settings_changed(); }
                            }
                        }
                        HorizontalLayout {
                            Text { text: "Size"; width: 82px; }
                            SpinBox { minimum: 1; maximum: 100; value <=> root.reference-size; edited => { root.settings_changed(); } }
                        }
                        HorizontalLayout {
                            Text { text: "Opacity"; width: 82px; }
                            Slider { minimum: 0; maximum: 1; step: 0.01; value <=> root.reference-opacity; changed(value) => { root.settings_changed(); } }
                        }
                        HorizontalLayout {
                            Text { text: "Offset X"; width: 82px; }
                            SpinBox { minimum: -500; maximum: 500; value <=> root.reference-x; edited => { root.settings_changed(); } }
                        }
                        HorizontalLayout {
                            Text { text: "Offset Y"; width: 82px; }
                            SpinBox { minimum: -500; maximum: 500; value <=> root.reference-y; edited => { root.settings_changed(); } }
                        }
                    }

                    HorizontalLayout {
                        Text { text: "Position X"; width: 82px; vertical-alignment: center; }
                        SpinBox { minimum: -500; maximum: 500; value <=> root.offset-x; edited => { root.settings_changed(); } }
                    }
                    HorizontalLayout {
                        Text { text: "Position Y"; width: 82px; vertical-alignment: center; }
                        SpinBox { minimum: -500; maximum: 500; value <=> root.offset-y; edited => { root.settings_changed(); } }
                    }
                }
            }

            Rectangle { width: 1px; background: Palette.border; }

            VerticalLayout {
                width: 176px;
                spacing: 8px;
                Text { text: "Preview"; font-weight: 600; height: 22px; }
                Rectangle {
                    background: root.preview-background;
                    border-radius: 4px;
                    border-color: Palette.border;
                    border-width: 1px;
                    width: 100%;
                    height: 176px;
                    clip: true;
                    Image {
                        source: root.preview-image;
                        image-fit: contain;
                        width: 100%;
                        height: 100%;
                    }
                }
                HorizontalLayout {
                    height: 30px;
                    Text { text: "Background"; vertical-alignment: center; }
                    ColorField {
                        horizontal-stretch: 1;
                        value <=> root.preview-background-text;
                        swatch-color: root.preview-background;
                        align-right: true;
                        committed => { root.settings_changed(); }
                    }
                }
                Button {
                    text: "Share code";
                    height: 30px;
                    primary: true;
                    clicked => { root.profile-is-export = true; root.export_profile(); root.profile-panel-visible = true; }
                }
            }
        }
    }
}
